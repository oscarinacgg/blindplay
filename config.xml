<?xml version="1.0" encoding="UTF-8"?>
<widget id="com.tecnodisca.brailledigital" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Braille Digital</name>
    <description>Novedades: 📜 Funcionalidades Disponibles (v1.0.0)
• Cajetín Interactivo: Exploración táctil y sonora de los 6 puntos del sistema Braille con vibración integrada.
• Guía de Aprendizaje: Tutorial detallado sobre la estructura del sistema y el uso de la tecnología táctil.
• Entrenamiento de Escritura: Sistema de retos y confirmación para practicar la formación de letras y palabras.
• Traductor y Generador de Tarjetas: Conversión de texto a relieve visual con opción de descarga para compartir.
• Optimización de Contraste: Interfaz diseñada bajo estándares de baja visión con soporte para gráficos en amarillo y negro.
• Compatibilidad con Lectores de Pantalla: Etiquetas técnicas aplicadas en toda la interfaz para una navegación fluida con TalkBack.
• Notificaciones Diarias: Recibe diariamente un dato curioso o una efeméride sobre el mundo de la discapacidad visual, acompañados de gráficos SVG y sonidos temáticos.
</description>
    <author email="tecnodisca@gmail.com">Tecnodisca - Oscarina González Güipe</author>
    <content src="index.html" />
    <icon src="res/icon.png" />

    <preference name="Orientation" value="portrait" />
    <preference name="AndroidXEnabled" value="true" />
    <preference name="AndroidPersistentFileLocation" value="Compatibility" />
    
    <preference name="Hostname" value="localhost" />
    <preference name="Scheme" value="http" />
    <preference name="AllowInlineMediaPlayback" value="true" />
    <preference name="AutoplayImmutableBadge" value="true" />
    <preference name="MixedContentMode" value="0" /> <access origin="*" />
    <allow-navigation href="*" />
    <allow-navigation href="https://localhost/*" />
    <allow-navigation href="https://*.peerjs.com" />
    <allow-intent href="https://*.peerjs.com" />
    
    <preference name="AllowUntrustedRPC" value="true" />
    
    <plugin name="cordova-plugin-android-permissions" spec="^1.1.5" />    
    <plugin name="cordova-plugin-file" spec="^8.0.0" />
    <plugin name="cordova-plugin-device" spec="^3.0.0" />
    <plugin name="cordova-plugin-x-socialsharing" spec="^6.0.4" />

<platform name="android">
    <icon src="res/icon.png" />

    <adaptive-icon>
        <background src="res/icon_background.png" />
        <foreground src="res/icon_foreground.png" />
    </adaptive-icon>
    <allow-intent href="market:*" />
    <allow-intent href="whatsapp:*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />

    <access origin="whatsapp:*" launch-external="yes" />
    <allow-intent href="whatsapp:*" />
    
    <preference name="InAppBrowserStorageEnabled" value="true" />
    <preference name="AndroidLaunchMode" value="singleInstance" />

    <config-file target="AndroidManifest.xml" parent="/*">
        <uses-permission android:name="android.permission.INTERNET" />
        <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
        <uses-permission android:name="android.permission.VIBRATE" />
        <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
        <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
        <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <queries>
        <package android:name="com.whatsapp" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="whatsapp" />
        </intent>
    </queries>
</config-file>

    <config-file target="AndroidManifest.xml" parent="/manifest/application/activity">
        <intent-filter>
            <action android:name="android.intent.action.SEND" />
            <category android:name="android.intent.category.DEFAULT" />
            <data android:mimeType="application/pdf" />
        </intent-filter>
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="file" />
            <data android:scheme="content" />
            <data android:mimeType="application/pdf" />
        </intent-filter>
    </config-file>
</platform>
</widget>